---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE, wa } from '../../lib/i18n.js';
import css from '../../data/article.css?raw';
export async function getStaticPaths() {
  return (await getCollection('blog')).filter((p) => p.data.publicat).map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const url = `${SITE}/blog/${post.id}/`;
const luni = ['ianuarie', 'februarie', 'martie', 'aprilie', 'mai', 'iunie', 'iulie', 'august', 'septembrie', 'octombrie', 'noiembrie', 'decembrie'];
const dt = d.data; const dataText = `${dt.getUTCDate()} ${luni[dt.getUTCMonth()]} ${dt.getUTCFullYear()}`;
const iso = dt.toISOString().slice(0, 10);
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: d.seo_titlu || d.titlu, description: d.descriere, image: [SITE + d.imagine], datePublished: iso, dateModified: iso, inLanguage: 'ro', mainEntityOfPage: url, author: { '@type': 'Organization', name: 'BEE TRAVEL', url: 'https://beetravel.md/' }, publisher: { '@type': 'Organization', name: 'BEE TRAVEL', logo: { '@type': 'ImageObject', url: 'https://beetravel.md/images/bee-travel-logo.png' } } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Acasă', item: 'https://beetravel.md/' }, { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://beetravel.md/blog/' }, { '@type': 'ListItem', position: 3, name: d.fir || d.titlu, item: url }] },
  ...(d.intrebari.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.intrebari.map((q) => ({ '@type': 'Question', name: q.intrebare, acceptedAnswer: { '@type': 'Answer', text: q.raspuns } })) }] : []),
];
---
<Base lang="ro" path={`/blog/${post.id}`} title={d.seo_titlu || d.titlu} description={d.descriere} jsonld={jsonld} ogType="article" ogImage={d.imagine} preload={[d.imagine]} alternates={false}>
<style is:inline set:html={css}></style>
<article class="art">
<p class="crumbs"><a href="/">Acasă</a> › <a href="/blog/">Blog</a> › {d.fir || d.titlu}</p>
<p class="text-sm font-semibold uppercase tracking-wide text-[#b08d2b]">{d.eticheta ? `${d.eticheta} · ` : ''}{dataText}</p>
<h1 class="font-serif">{d.titlu}</h1>
<div class="hero"><img src={d.imagine} alt={d.imagine_alt} width="1200" height="675" /></div>
{d.intro && <p class="lead">{d.intro}</p>}
<Content />
{d.intrebari.length > 0 && (<><h2>Întrebări frecvente</h2>{d.intrebari.map((q) => <details class="faq"><summary>{q.intrebare}</summary><p>{q.raspuns}</p></details>)}</>)}
{d.cta_titlu && (<div class="cta"><p class="cta-t">{d.cta_titlu}</p>{d.cta_text && <p>{d.cta_text}</p>}<p class="cta-b"><a class="btn red" href={wa(d.cta_whatsapp)}>Scrie pe WhatsApp</a> {d.cta_tur && <a class="btn" href={d.cta_tur}>{d.cta_tur_text || 'Vezi turul'}</a>}</p></div>)}
{d.credit_foto && <p class="credit">{d.credit_foto}</p>}
</article>
</Base>
