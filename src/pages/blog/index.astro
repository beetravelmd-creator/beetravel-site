---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const posts = (await getCollection('blog')).filter((p) => p.data.publicat).sort((a, b) => b.data.data - a.data.data);
const luni = ['ianuarie', 'februarie', 'martie', 'aprilie', 'mai', 'iunie', 'iulie', 'august', 'septembrie', 'octombrie', 'noiembrie', 'decembrie'];
const fmt = (dt) => `${dt.getUTCDate()} ${luni[dt.getUTCMonth()]} ${dt.getUTCFullYear()}`;
---
<Base lang="ro" path="/blog" title="Blog BEE TRAVEL – ghiduri pentru excursii în Moldova" description="Ghiduri BEE TRAVEL: pelerinaje, vinării, Orheiul Vechi și excursii de o zi din Chișinău. Trasee, sfaturi practice și prețuri." alternates={false}>
<div class="mx-auto max-w-7xl px-4 py-12 lg:px-8"><h1 class="font-serif text-4xl font-bold">Blog</h1><p class="mt-3 max-w-3xl text-neutral-600">Ghiduri și sfaturi pentru excursii, pelerinaje și vinării din Moldova.</p>
<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{posts.map((p) => (<article class="flex flex-col overflow-hidden rounded-2xl border border-[#e7ddc4] bg-white shadow-sm transition hover:shadow-lg"><a href={`/blog/${p.id}/`} class="aspect-[4/3] w-full overflow-hidden bg-[#f3ece0]"><img src={p.data.imagine} alt={p.data.imagine_alt} loading="lazy" class="h-full w-full object-cover transition duration-500 hover:scale-105" /></a><div class="flex flex-1 flex-col gap-3 p-5"><p class="text-sm font-semibold uppercase tracking-wide text-[#b08d2b]">{p.data.eticheta ? `${p.data.eticheta} · ` : ''}{fmt(p.data.data)}</p><h2 class="font-serif text-lg font-bold leading-snug text-neutral-900"><a href={`/blog/${p.id}/`}>{p.data.titlu}</a></h2><p class="line-clamp-3 text-sm text-neutral-600">{p.data.descriere}</p><div class="pt-2 mt-auto"><a href={`/blog/${p.id}/`} class="mt-2 block w-full rounded-full border border-neutral-900 px-4 py-2.5 text-center text-xs font-bold uppercase tracking-wide text-neutral-900 transition hover:bg-neutral-900 hover:text-white">Citește</a></div></div></article>))}</div></div>
</Base>
