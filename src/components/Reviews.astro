---
import Base from '../layouts/Base.astro';
import { L } from '../lib/i18n.js';
import pagini from '../data/pagini.json';
const { lang, admin } = Astro.props;
const T = {
  ro: { tagline: 'BEE TRAVEL · Călătorim cu suflet', title: 'Recenziile călătorilor', subtitle: 'Ai călătorit cu noi? Povestește-ne experiența ta.', adminTitle: 'Administrarea recenziilor', adminSubtitle: 'Aprobă, ascunde sau șterge recenziile primite.', adminAccess: 'Acces administrator', password: 'Parola', authenticate: 'Autentificare', passwordNote: 'Parola este configurată în Netlify. Nu o trimite prin mesaje.', formTitle: 'Scrie o recenzie', publicName: 'Numele afișat public', email: 'E-mail (nu se publică)', tour: 'Turul ales (opțional)', rating: 'Nota', chooseRating: 'Alege nota', review: 'Recenzia', trap: 'Lasă gol', consent: 'Sunt de acord cu prelucrarea datelor și publicarea numelui afișat, notei și recenziei, conform', privacy: 'politicii de confidențialitate', publishNote: 'Recenzia apare pe site după aprobare. E-mailul rămâne privat.', send: 'Trimite recenzia', back: 'Înapoi la pagina principală' },
  en: { tagline: 'BEE TRAVEL · We travel with soul', title: 'Traveller Reviews', subtitle: 'Have you travelled with us? Tell us about your experience.', adminTitle: 'Review Administration', adminSubtitle: 'Approve, hide or delete received reviews.', adminAccess: 'Administrator access', password: 'Password', authenticate: 'Sign in', passwordNote: 'The password is configured in Netlify. Do not send it in messages.', formTitle: 'Write a review', publicName: 'Name shown publicly', email: 'E-mail (not published)', tour: 'Selected tour (optional)', rating: 'Rating', chooseRating: 'Choose a rating', review: 'Review', trap: 'Leave blank', consent: 'I agree to the processing of my data and publication of the displayed name, rating and review, according to the', privacy: 'privacy policy', publishNote: 'The review appears on the site after approval. Your e-mail remains private.', send: 'Submit review', back: 'Back to homepage' },
  ru: { tagline: 'BEE TRAVEL · Путешествуем с душой', title: 'Отзывы путешественников', subtitle: 'Вы путешествовали с нами? Расскажите нам о своих впечатлениях.', adminTitle: 'Администрирование отзывов', adminSubtitle: 'Одобряйте, скрывайте или удаляйте полученные отзывы.', adminAccess: 'Доступ администратора', password: 'Пароль', authenticate: 'Войти', passwordNote: 'Пароль настроен в Netlify. Не отправляйте его в сообщениях.', formTitle: 'Оставить отзыв', publicName: 'Имя, отображаемое публично', email: 'Электронная почта (не публикуется)', tour: 'Выбранный тур (необязательно)', rating: 'Оценка', chooseRating: 'Выберите оценку', review: 'Отзыв', trap: 'Оставьте пустым', consent: 'Я согласен(на) на обработку моих данных и публикацию отображаемого имени, оценки и отзыва согласно', privacy: 'политике конфиденциальности', publishNote: 'Отзыв появится на сайте после одобрения. Электронная почта остаётся конфиденциальной.', send: 'Отправить отзыв', back: 'Вернуться на главную' },
}[lang];
const CSS = `.bee-reviews{background:#fff8ed;min-height:70vh;padding:48px 20px;color:#203d35}.bee-reviews .wrap{max-width:900px;margin:auto}.bee-reviews h1{font-size:clamp(30px,5vw,48px);font-weight:700;line-height:1.2;margin-bottom:18px}.bee-reviews h2{font-size:24px;font-weight:700;margin-bottom:16px}.bee-reviews p{line-height:1.65}.bee-reviews .panel{background:#fffdf8;border:1px solid #e7ddc4;border-radius:22px;padding:24px;margin:24px 0}.bee-reviews label{display:block;margin-top:14px;font-weight:600}.bee-reviews input:not([type=checkbox]),.bee-reviews textarea,.bee-reviews select{display:block;width:100%;max-width:100%;background:white;border:1px solid #b5b9af;border-radius:10px;padding:12px;font:inherit;font-size:16px;margin-top:6px;color:#222}.bee-reviews textarea{min-height:150px}.bee-reviews button{min-height:44px;border-radius:24px;padding:10px 20px;background:#20473e;color:white;cursor:pointer;margin:14px 8px 0 0;font:inherit}.bee-reviews button:disabled{opacity:.55;cursor:wait}.bee-reviews .danger{background:#b91c1c}.bee-reviews .message{padding:14px;border:1px solid #b08d2b;border-radius:12px;margin:16px 0}.bee-reviews small{display:block;color:#575c54;margin-top:8px}.bee-reviews .review-text{white-space:pre-wrap;overflow-wrap:anywhere}.bee-reviews .stars{color:#b08d2b;font-size:20px;letter-spacing:.08em}.bee-reviews a{text-decoration:underline}.bee-reviews .trap{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}.bee-reviews :focus-visible{outline:3px solid #b08d2b;outline-offset:3px}`;
let initial = [];
if (!admin) { try { for (const u of ['https://beetravel.md/api/reviews?action=public', 'https://beetravel.md/.netlify/functions/bee-reviews?action=public']) { try { const res = await fetch(u); if (res.ok) { const j = await res.json(); if (Array.isArray(j) && j.length) { initial = j; break; } } } catch (e) {} } } catch (e) {} }
const tourName = (x) => x === 'Pelerinaj Curchi, Orheiul vechi' ? (lang === 'ru' ? 'Паломничество в Курки и Старый Орхей' : lang === 'en' ? 'Pilgrimage to Curchi and Orheiul Vechi' : x) : x === 'Pelerinaj la 9 mănăstiri' ? (lang === 'ru' ? 'Паломничество по 9 монастырям' : lang === 'en' ? 'Pilgrimage to 9 monasteries' : x) : x;
const starsLabel = (n) => n + (lang === 'ru' ? ' из 5 звёзд' : lang === 'en' ? ' out of 5 stars' : ' din 5 stele');
const dateFmt = (d) => new Date(d).toLocaleDateString(lang === 'ru' ? 'ru-RU' : lang === 'en' ? 'en-GB' : 'ro-RO');
const m = pagini[admin ? 'administrare-recenzii' : 'recenzii'];
const title = admin ? T.adminTitle + ' | BEE TRAVEL' : lang === 'ro' ? m.title : m[lang].title;
const description = admin ? '' : lang === 'ro' ? m.description : m[lang].description;
---
<Base lang={lang} path={admin ? '/administrare-recenzii' : '/recenzii'} title={title} description={description} noindex={admin} jsonld={!admin && lang === 'ro' ? m.jsonld?.[0] : null}>
<div class="bee-reviews" data-reviews={admin ? 'admin' : 'public'}><style set:html={CSS}></style><div class="wrap"><p>{T.tagline}</p><h1>{admin ? T.adminTitle : T.title}</h1><p>{admin ? T.adminSubtitle : T.subtitle}</p><div class="message" role="status" aria-live="polite" data-msg hidden></div>
{admin && (<>
<form class="panel" data-login><h2>{T.adminAccess}</h2><label>{T.password}<input type="password" required autocomplete="current-password" maxlength="200" name="password" /></label><button>{T.authenticate}</button><small>{T.passwordNote}</small></form>
<div data-admin-tools hidden><button type="button" data-reload></button><button type="button" data-logout></button></div>
</>)}
<div data-list>{initial.map((x) => <article class="panel"><h2>{x.name}</h2><p class="stars" aria-label={starsLabel(x.rating)}>{"★".repeat(x.rating)}{"☆".repeat(5 - x.rating)}</p>{x.tour && <p>{tourName(x.tour)}</p>}<p class="review-text">{x.text}</p><small>{dateFmt(x.created)}</small></article>)}</div>
{!admin && (<form class="panel" data-submit><h2>{T.formTitle}</h2><label>{T.publicName}<input required minlength="2" maxlength="80" autocomplete="name" name="name" /></label><label>{T.email}<input type="email" required maxlength="254" autocomplete="email" name="email" /></label><label>{T.tour}<input maxlength="160" name="tour" /></label><label>{T.rating}<select name="rating" required><option value="" disabled selected>{T.chooseRating}</option><option value="5">5 / 5</option><option value="4">4 / 5</option><option value="3">3 / 5</option><option value="2">2 / 5</option><option value="1">1 / 5</option></select></label><label>{T.review}<textarea name="text" required minlength="10" maxlength="3000"></textarea></label><label class="trap" aria-hidden="true">{T.trap}<input tabindex="-1" autocomplete="off" name="website" /></label><label><input type="checkbox" required name="consent" />{T.consent} <a href={L(lang, '/politica-de-confidentialitate')}>{T.privacy}</a>.</label><small>{T.publishNote}</small><button>{T.send}</button></form>)}
<a href={L(lang, '/')}>{T.back}</a></div></div>
<script is:inline slot="end" src="/assets/reviews.js" defer></script>
</Base>
