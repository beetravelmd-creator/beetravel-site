---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { L, LIST_UI, localTour, catalogPrice, catalogPrivate, categorii } from '../lib/i18n.js';
import pagini from '../data/pagini.json';
const { lang } = Astro.props;
const r = LIST_UI[lang];
const tours = (await getCollection('tours')).filter((t) => t.data.publicat).sort((a, b) => a.data.ordine - b.data.ordine).map((t) => localTour(t, lang));
const m = pagini.destinatii;
const title = lang === 'ro' ? m.title : m[lang].title;
const description = lang === 'ro' ? m.description : m[lang].description;
const on = 'border-[#b91c1c] bg-[#b91c1c] text-white', off = 'border-[#e7ddc4] text-neutral-700';
---
<Base lang={lang} path="/destinatii" title={title} description={description} jsonld={lang === 'ro' ? m.jsonld?.[0] : null}>
<div class="mx-auto max-w-7xl px-4 py-12 lg:px-8"><h1 class="font-serif text-4xl font-bold">{r.title}</h1><p class="mt-3 max-w-3xl text-neutral-600">{r.intro}</p><nav class="mt-6 flex flex-wrap gap-2" data-cats><a href={L(lang, '/destinatii')} data-cat="" class={'rounded-full border px-4 py-2 text-sm font-semibold ' + on}>{r.all}</a>{categorii.map((c) => <a href={L(lang, '/destinatii?categorie=' + c.slug)} data-cat={c.slug} class={'rounded-full border px-4 py-2 text-sm font-semibold ' + off}>{c[lang]}</a>)}</nav>{categorii.map((c) => (<section id={c.slug} data-cat-section class="mt-14 scroll-mt-24"><h2 class="mb-1 font-serif text-2xl font-bold">{c[lang]}</h2><p class="mb-6 text-sm text-neutral-500">{r.note}</p><div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{tours.filter((t) => t.categorie === c.slug).map((t) => (<article class="flex flex-col overflow-hidden rounded-2xl border border-[#e7ddc4] bg-white shadow-sm transition hover:shadow-lg"><div class="aspect-[4/3] w-full overflow-hidden bg-[#f3ece0]"><img src={t.image} alt={t.alt} loading="lazy" class="h-full w-full object-cover transition duration-500 hover:scale-105" /></div><div class="flex flex-1 flex-col gap-3 p-5"><h3 class="font-serif text-lg font-bold leading-snug text-neutral-900">{t.name}</h3><p class="line-clamp-3 text-sm text-neutral-600">{t.route}</p><div class="mt-auto border-t border-[#e7ddc4] pt-3"><div class="text-sm font-bold tracking-wide text-[#b91c1c]">{catalogPrice(t, lang)}</div><div class="mt-1 text-xs text-neutral-500">{catalogPrivate(t, lang)}</div></div><div class="pt-2"><a href={L(lang, '/rezerva-tur?tour=' + t.id)} class="block w-full rounded-full bg-[#b91c1c] px-4 py-3 text-center text-sm font-bold uppercase tracking-wide text-white shadow-sm transition hover:brightness-110">{r.request}</a><a href={L(lang, '/destinatii/' + t.id)} class="mt-2 block w-full rounded-full border border-neutral-900 px-4 py-2.5 text-center text-xs font-bold uppercase tracking-wide text-neutral-900 transition hover:bg-neutral-900 hover:text-white">{r.details}</a></div></div></article>))}</div></section>))}</div>
</Base>
