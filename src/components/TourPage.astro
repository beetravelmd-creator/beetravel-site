---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { L, SITE, TOUR_UI, GRID_UI, localTour, wa, categoryName, NAV } from '../lib/i18n.js';
const { lang, id } = Astro.props;
const entry = await getEntry('tours', id);
const t = localTour(entry, lang);
const r = TOUR_UI[lang];
const all = (await getCollection('tours')).filter((x) => x.data.publicat).sort((a, b) => a.data.ordine - b.data.ordine);
const related = all.filter((x) => x.data.categorie === t.categorie && x.id !== id).slice(0, 3).map((x) => localTour(x, lang));
const hero = t.gallery[0] || t.image;
const path = '/destinatii/' + id;
const url = SITE + L(lang, path);
const title = lang === 'ro' ? entry.data.seo_titlu || `${t.name} | BEE TRAVEL` : `${t.name} | BEE TRAVEL`;
const description = lang === 'ro' ? entry.data.seo_descriere || t.route : t.route;
const num = (s, re) => { const m = s && s.match(re); return m ? m[1] : null; };
const abs = (u) => (/^https?:/.test(u) ? u : SITE + u);
const gu = GRID_UI[lang];
const offers = [];
if (t.grid.length) offers.push({ '@type': 'AggregateOffer', priceCurrency: 'EUR', lowPrice: String(Math.min(...t.grid.map((g) => g.pret))), highPrice: String(Math.max(...t.grid.map((g) => g.pret))), offerCount: String(t.grid.length), url });
const g = num(entry.data.pret_grup, /(\d+)\s*MDL/i);
if (g && !t.grid.length) offers.push({ '@type': 'Offer', name: `Transport grup 8–16 persoane: ${entry.data.pret_grup}`, price: g, priceCurrency: 'MDL', url });
const p = num(entry.data.pret_privat, /EUR\s*(\d+)/i) || num(entry.data.pret_privat, /(\d+)\s*€/);
if (p && !t.grid.length) offers.push({ '@type': 'Offer', name: `Tur privat: ${entry.data.pret_privat}`, price: p, priceCurrency: 'EUR', url });
const stops = t.route.split(/→/).map((s) => s.replace(/\..*$/, '').trim()).filter(Boolean);
const jsonld = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'TouristTrip', name: t.name, description, url, image: abs(t.image), touristType: t.category, inLanguage: lang,
    provider: { '@type': 'TravelAgency', '@id': 'https://beetravel.md/#agency', name: 'BEE TRAVEL', url: 'https://beetravel.md/', telephone: '+37379520914' },
    itinerary: { '@type': 'ItemList', itemListElement: stops.map((s, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Place', name: s } })) }, offers },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: NAV[0][1][lang], item: SITE + L(lang, '/') },
    { '@type': 'ListItem', position: 2, name: NAV[2][1][lang], item: SITE + L(lang, '/destinatii') },
    { '@type': 'ListItem', position: 3, name: t.name, item: url } ] } ] };
---
<Base lang={lang} path={path} title={title} description={description} jsonld={jsonld} preload={[hero]} ogImage={/^https?:/.test(t.image) ? undefined : t.image}>
<div class="mx-auto max-w-6xl px-4 py-12 lg:px-8"><p class="text-sm font-semibold uppercase tracking-wide text-[#b08d2b]">{t.category}</p><h1 class="mt-1 font-serif text-4xl font-bold">{t.name}</h1><div class="mt-6 aspect-video overflow-hidden rounded-2xl border border-[#e7ddc4]"><img src={hero} alt={t.alt} class="h-full w-full object-cover" /></div>{t.gallery.length > 1 && (<section class="mt-8"><h2 class="font-serif text-2xl font-bold">{r.gallery}</h2><p class="mt-1 text-sm text-neutral-500">{r.gallerySub}</p><div class="mt-5 flex gap-4 overflow-x-auto pb-3 snap-x snap-mandatory" data-gallery>{t.gallery.map((src, i) => <button type="button" data-src={src} class="aspect-[4/3] w-64 flex-none snap-start overflow-hidden rounded-xl border border-[#e7ddc4] bg-neutral-100" aria-label={`${r.gallery} ${i + 1}`}><img src={src} alt={`${t.name} – ${i + 1}`} loading="lazy" class="h-full w-full object-cover transition duration-300 hover:scale-105" /></button>)}</div>{t.credit && <p class="mt-1 text-[11px] leading-snug text-neutral-500">{t.credit}</p>}</section>)}<div class="mt-10 grid gap-8 lg:grid-cols-3"><div class="space-y-6 lg:col-span-2"><section><h2 class="font-serif text-xl font-bold">{r.route}</h2><p class="mt-2 leading-relaxed text-neutral-700">{t.route}</p></section>{t.duration && <section><h2 class="font-serif text-xl font-bold">{r.duration}</h2><p class="mt-2">{t.duration}</p></section>}<section><h2 class="font-serif text-xl font-bold">{r.inc}</h2><p class="mt-2 leading-relaxed text-neutral-700">{t.includes}</p></section><section><h2 class="font-serif text-xl font-bold">{r.exc}</h2><p class="mt-2 leading-relaxed text-neutral-700">{t.excludes}</p></section></div><aside class="space-y-4 rounded-2xl border border-[#e7ddc4] bg-[#fbf6ea] p-6">{t.grid.length > 0 ? (<div><div class="text-xs uppercase tracking-wide text-neutral-500">{gu.title}</div><div class="text-xs text-neutral-500">{gu.sub}</div><table class="mt-3 w-full text-sm"><tbody>{t.grid.map((g) => <tr class="border-t border-[#e7ddc4]"><td class="py-1.5 text-neutral-700">{/^\d/.test(g.persoane) ? `${g.persoane} ${gu.pers}` : g.persoane}</td><td class="py-1.5 font-serif font-bold" style="text-align:right">{lang === 'en' ? `€${g.pret}` : `${g.pret} €`}</td></tr>)}</tbody></table>{t.data.pret_nota && <p class="mt-2 text-xs text-neutral-500">{t.data.pret_nota}</p>}{t.grid.length > 1 && <p class="mt-2 text-xs text-neutral-500">{gu.big}</p>}</div>) : (<><div><div class="text-xs uppercase tracking-wide text-neutral-500">{r.priv}</div><div class="font-serif text-lg font-bold">{t.priv}</div></div><div><div class="text-xs uppercase tracking-wide text-neutral-500">{r.ford}</div><div class="font-serif text-lg font-bold">{t.group}</div></div></>)}<a href={L(lang, '/rezerva-tur?tour=' + id)} class="block rounded-full bg-[#b91c1c] px-5 py-3 text-center font-semibold text-white transition hover:brightness-110">{r.request}</a><a href={wa(`${r.wa} „${t.name}”.`)} target="_blank" rel="noopener noreferrer" class="block rounded-full bg-[#25D366] px-5 py-3 text-center font-semibold text-white transition hover:brightness-110">{r.book}</a></aside></div>{related.length > 0 && (<section class="mt-16"><h2 class="mb-6 font-serif text-2xl font-bold">{r.related}</h2><div class="grid gap-4 sm:grid-cols-3">{related.map((a) => <a href={L(lang, '/destinatii/' + a.id)} class="rounded-xl border border-[#e7ddc4] p-4"><div class="font-semibold">{a.name}</div></a>)}</div></section>)}</div>
<div data-lightbox hidden class="fixed inset-0 z-[100] flex items-center justify-center bg-black/90 p-4"><button type="button" data-close class="absolute right-5 top-5 z-10 rounded-full bg-white px-4 py-2 font-semibold text-black">{r.close} ×</button><button type="button" data-prev class="absolute left-4 top-1/2 z-10 -translate-y-1/2 rounded-full bg-white/90 px-5 py-3 text-3xl font-bold text-black">‹</button><img alt={t.name} class="max-h-[85vh] max-w-[94vw] sm:max-h-[88vh] sm:max-w-[94vw] w-auto h-auto object-contain" /><button type="button" data-next class="absolute right-4 top-1/2 z-10 -translate-y-1/2 rounded-full bg-white/90 px-5 py-3 text-3xl font-bold text-black">›</button></div>
</Base>
