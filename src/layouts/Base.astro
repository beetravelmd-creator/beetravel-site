---
import { NAV, UI, L, SITE, settings } from '../lib/i18n.js';
interface Props { lang: string; path: string; title: string; description?: string; jsonld?: any; preload?: string[]; ogType?: string; ogImage?: string; noindex?: boolean; alternates?: boolean; }
const { lang, path, title, description = '', jsonld, preload = [], ogType = 'website', ogImage, noindex = false, alternates = true } = Astro.props;
const u = UI[lang];
const canonical = SITE + L(lang, path);
const norm = (p) => (p.endsWith('/') ? p : p + '/');
const cur = norm(path);
const isActive = (href) => (href === '/' ? cur === '/' : cur === norm(href) || cur.startsWith(norm(href)));
const navCls = 'rounded-full px-3 py-2 text-[13px] font-semibold uppercase tracking-wide transition ';
const navOn = 'bg-[#b08d2b] text-white active';
const navOff = 'text-neutral-700 hover:bg-[#f3ece0] hover:text-[#b08d2b]';
const locale = { ro: 'ro_RO', ru: 'ru_RU', en: 'en_US' }[lang];
const langs = ['en', 'ro', 'ru'];
const langHref = (l) => (alternates || l === lang ? L(l, path) : L(l, '/'));
---
<!DOCTYPE html>
<html lang={lang} translate="no">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="preload" as="image" href="/images/bee-travel-logo.png" />
{preload.map((p) => <link rel="preload" as="image" href={p} />)}
<link rel="stylesheet" href="/assets/site.css" />
<link rel="icon" type="image/png" href="/images/bee-travel-logo.png" />
<title>{title}</title>
<meta name="google" content="notranslate" />
<meta name="google-site-verification" content="rIrig3hjxWPJ157FoPWT7YSOJoRDAzTKicB_eeNbVu4" />
{description && <meta name="description" content={description} />}
{noindex && <meta name="robots" content="noindex" />}
<link rel="canonical" href={canonical} />
{alternates && !noindex && ['ro', 'ru', 'en'].map((l) => <link rel="alternate" hreflang={l} href={SITE + L(l, path)} />)}
{alternates && !noindex && <link rel="alternate" hreflang="x-default" href={SITE + L('ro', path)} />}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="BEE TRAVEL" />
<meta property="og:locale" content={locale} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
{ogImage && <meta property="og:image" content={SITE + ogImage} />}
<meta name="twitter:card" content="summary_large_image" />
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
<slot name="head" />
<script is:inline>if(/(invite|recovery|confirmation|email_change)_token=/.test(location.hash))location.replace("/admin/"+location.hash);</script>
</head>
<body class="flex min-h-screen flex-col bg-white text-neutral-900" data-lang={lang} data-ga={settings.google_analytics}>
<header class="sticky top-0 z-50 border-b border-[#e7ddc4] bg-white/95 backdrop-blur"><div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2 lg:px-8"><a href={L(lang, '/')} class="flex items-center gap-2 shrink-0 cursor-pointer text-left" aria-label={u.home}><img src="/images/bee-travel-logo.png" alt="BEE TRAVEL" class="h-16 w-16 rounded-full object-cover shadow-sm" /><span class="hidden flex-col leading-tight sm:flex"><span class="font-serif text-2xl font-bold tracking-wide">BEE TRAVEL</span><span class="text-[11px] uppercase tracking-[0.15em] text-[#b08d2b]">{u.tagline}</span></span></a><nav class="hidden flex-1 items-center justify-center gap-1 xl:flex">{NAV.filter(([, t]) => (!t.only || t.only.includes(lang)) && t.top !== false).map(([href, t]) => <a href={L(lang, href)} class={navCls + 'whitespace-nowrap ' + (isActive(href) ? navOn : navOff)} aria-current={isActive(href) ? 'page' : undefined}>{(t.short && t.short[lang]) || t[lang]}</a>)}</nav><div class="hidden items-center gap-3 lg:flex"><a href={'tel:' + settings.telefon_link} class="shrink-0 whitespace-nowrap rounded-full bg-[#b91c1c] px-4 py-2 text-sm font-semibold text-white">{settings.telefon}</a><div class="flex rounded-full border border-[#e7ddc4] p-1">{langs.map((l) => <a href={langHref(l)} data-setlang={l} hreflang={l} class={'rounded-full px-2 py-1 text-xs font-bold ' + (l === lang ? 'bg-[#b08d2b] text-white' : 'text-neutral-600')}>{l.toUpperCase()}</a>)}</div></div><button type="button" aria-label="Menu" aria-expanded="false" data-menu class="flex h-10 w-10 items-center justify-center rounded-full border border-[#e7ddc4] xl:hidden"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"></path></svg></button></div><nav class="border-t border-[#e7ddc4] bg-white px-4 py-3 xl:hidden" data-mobile-nav hidden><div class="mb-3 flex gap-2">{langs.map((l) => <a href={langHref(l)} data-setlang={l} hreflang={l} class={'rounded-full px-3 py-1.5 text-xs font-bold ' + (l === lang ? 'bg-[#b08d2b] text-white' : 'border')}>{l.toUpperCase()}</a>)}</div><ul class="flex flex-col gap-1">{NAV.filter(([, t]) => !t.only || t.only.includes(lang)).map(([href, t]) => <li><a href={L(lang, href)} class={'block rounded-lg px-3 py-2.5 text-sm font-semibold uppercase ' + (isActive(href) ? 'bg-[#b08d2b] text-white active' : 'text-neutral-700 hover:bg-[#f3ece0]')}>{t[lang]}</a></li>)}</ul><a href={'tel:' + settings.telefon_link} class="mt-3 flex justify-center whitespace-nowrap rounded-full bg-[#b91c1c] px-4 py-2.5 text-sm font-semibold text-white">{settings.telefon}</a></nav></header>
<main class="flex-1"><slot /></main>
<footer class="border-t border-[#e7ddc4] bg-neutral-950 text-neutral-300"><div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:grid-cols-2 lg:grid-cols-4 lg:px-8"><div><div class="flex items-center gap-2"><img src="/images/bee-travel-logo.png" alt="BEE TRAVEL" class="h-12 w-12 rounded-full object-cover" /><div><div class="font-serif text-lg font-bold text-white">BEE TRAVEL</div><div class="text-xs uppercase tracking-[0.15em] text-[#d4af5a]">{u.tagline}</div></div></div><p class="mt-4 text-sm leading-relaxed text-neutral-400">{u.footerText}</p></div><div><h3 class="mb-3 text-sm font-bold uppercase tracking-wide text-white">{u.nav}</h3><ul class="space-y-2 text-sm">{NAV.filter(([, t]) => !t.only || t.only.includes(lang)).map(([href, t]) => <li><a href={L(lang, href)} class="text-neutral-400 hover:text-[#d4af5a]">{t[lang]}</a></li>)}</ul></div><div><h3 class="mb-3 text-sm font-bold uppercase tracking-wide text-white">{u.info}</h3><ul class="space-y-2 text-sm">{u.legal.map(([href, t]) => <li><a href={L(lang, href)} class="text-neutral-400 hover:text-[#d4af5a]">{t}</a></li>)}</ul></div><div><h3 class="mb-3 text-sm font-bold uppercase tracking-wide text-white">{u.contact}</h3><ul class="space-y-2 text-sm text-neutral-400"><li>{u.city}</li><li><a href={'tel:' + settings.telefon_link} class="hover:text-[#d4af5a]">{u.phoneLabel}: {settings.telefon}</a></li><li><a href={'mailto:' + settings.email} class="hover:text-[#d4af5a]">{settings.email}</a></li></ul></div></div><div class="border-t border-white/10 px-4 py-5 text-center text-xs text-neutral-500">© {new Date().getFullYear()} BEE TRAVEL. {u.rights}</div></footer>
<div data-cookie hidden class="fixed inset-x-3 bottom-3 z-[100] mx-auto max-w-3xl rounded-2xl border border-[#e7ddc4] bg-white p-5 shadow-2xl sm:inset-x-6"><div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"><div class="max-w-xl"><p class="font-serif text-lg font-bold">{u.cookieT}</p><p class="mt-1 text-sm leading-relaxed text-neutral-600">{u.cookieP}</p><a href={L(lang, '/politica-cookie')} class="mt-2 inline-block text-sm font-semibold text-[#b91c1c] underline underline-offset-2">{u.cookieL}</a></div><div class="flex shrink-0 flex-wrap gap-2"><button type="button" data-consent="necessary" class="rounded-full border border-[#d8ccb0] px-4 py-2 text-sm font-semibold text-neutral-700">{u.cookieN}</button><button type="button" data-consent="accepted" class="rounded-full bg-[#b91c1c] px-4 py-2 text-sm font-semibold text-white">{u.cookieA}</button></div></div></div>
<script is:inline src="/assets/site.js" defer></script>
<slot name="end" />
</body>
</html>
